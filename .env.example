# Printer (LAN mode). On the P1S screen: Settings > Network (IP, access code), Settings > Device (serial).
BAMBU_IP=192.168.1.50
BAMBU_ACCESS_CODE=12345678
BAMBU_SERIAL=01P00A000000000

# Override only if installed somewhere non-standard.
# BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender
# BAMBU_STUDIO_BIN=/Applications/BambuStudio.app/Contents/MacOS/BambuStudio
