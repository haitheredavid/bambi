#!/bin/sh
# bambi CLI launcher. The plugin puts this directory on the Bash tool's PATH.
# Runs the source checkout when there is one (this plugin loaded in place from the bambi repo,
# or BAMBI_SRC), else the tagged release via uvx. cwd is left alone so workspace paths work.
set -e
here=$(cd "$(dirname "$0")" && pwd)
src=${BAMBI_SRC:-$(cd "$here/.." && pwd)}
if [ -f "$src/pyproject.toml" ] && [ -d "$src/src/bambi" ]; then
  exec uv run --quiet --project "$src" bambi "$@"
fi
# Pin to the tag matching this plugin's version, so CLI and skills move together.
ver=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$here/../.claude-plugin/plugin.json" | head -1)
exec uvx --quiet --from "git+https://github.com/haitheredavid/bambi@${BAMBI_REF:-v$ver}" bambi "$@"
